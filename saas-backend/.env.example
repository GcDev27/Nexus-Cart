# ══════════════════════════════════════════════════════════
# NexusCart SaaS — Variáveis de Ambiente (Backend)
# ══════════════════════════════════════════════════════════
# Copie este arquivo para .env e preencha os valores

# Banco de Dados PostgreSQL
DB_URL=jdbc:postgresql://localhost:5433/saas_db
DB_USERNAME=admin
DB_PASSWORD=adminpassword

# JWT
# Obrigatório em produção. Gere um valor único com: openssl rand -base64 48
# (no ./gradlew bootRun local, um segredo de desenvolvimento é usado se não for definido)
JWT_SECRET=
JWT_EXPIRATION=86400000

# Criptografia do Access Token dos gateways no banco. Obrigatório. Gere com: openssl rand -base64 32
# (no ./gradlew bootRun local, uma chave de desenvolvimento é usada se não for definida)
ENCRYPTION_KEY=

# Pix de teste e aprovação manual de pedidos. Deixe false em produção.
ALLOW_SIMULATED_PAYMENTS=false

# Porta do servidor
SERVER_PORT=8081

# CORS — origens permitidas (separar por vírgula se mais de uma)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL Docker
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword
POSTGRES_DB=saas_db
