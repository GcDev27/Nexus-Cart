# ══════════════════════════════════════════════════════════
# NexusCart SaaS — Variáveis de Ambiente (Backend)
# ══════════════════════════════════════════════════════════
# Copie este arquivo para .env e preencha os valores

# Banco de Dados PostgreSQL
DB_URL=jdbc:postgresql://localhost:5433/saas_db
DB_USERNAME=admin
DB_PASSWORD=adminpassword

# JWT
# Obrigatório em produção. Gere um valor único com: openssl rand -base64 48
# (no ./gradlew bootRun local, um segredo de desenvolvimento é usado se não for definido)
JWT_SECRET=
JWT_EXPIRATION=86400000

# Criptografia do Access Token dos gateways no banco. Obrigatório. Gere com: openssl rand -base64 32
# (no ./gradlew bootRun local, uma chave de desenvolvimento é usada se não for definida)
ENCRYPTION_KEY=

# Pix de teste e aprovação manual de pedidos. Deixe false em produção.
ALLOW_SIMULATED_PAYMENTS=false

# Porta do servidor
SERVER_PORT=8081

# CORS — origens permitidas (separar por vírgula se mais de uma)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Atrás de proxy/load balancer (Nginx, Railway, Render...): o IP real do cliente vem do
# X-Forwarded-For. "native" confia só em proxies da rede interna; use "none" se o backend
# ficar exposto direto, para ninguém forjar o IP e escapar do limite de requisições.
FORWARD_HEADERS_STRATEGY=native

# O banco é criado e atualizado pelas migrations do Flyway (src/main/resources/db/migration).
# "validate" só confere se as entidades batem com o banco. Não use "update" em produção.
DDL_AUTO=validate

# Limites de requisições por IP (opcional; estes são os padrões)
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_CHECKOUT_PER_10MIN=10
RATE_LIMIT_LOGIN_PER_10MIN=30
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_WEBHOOK_PER_MINUTE=120

# PostgreSQL Docker
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword
POSTGRES_DB=saas_db
