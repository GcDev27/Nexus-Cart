# ══════════════════════════════════════════════
# CentralCart SaaS — Gitignore Unificado
# ══════════════════════════════════════════════

# ─── Variáveis de Ambiente ───
.env
.env.*
!.env.example

# ─── Frontend (Next.js / Node) ───
node_modules/
.next/
out/
build/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
coverage/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel

# ─── Backend (Java / Spring Boot / Gradle) ───
.gradle/
build/
bin/
!**/src/main/**/build/
!**/src/test/**/build/
!**/src/main/**/bin/
!**/src/test/**/bin/
!gradle/wrapper/gradle-wrapper.jar
*.iml
*.iws
*.ipr

# ─── IDEs ───
.idea/
.vscode/
.project
.classpath
.factorypath
.settings/
.springBeans
.sts4-cache
.apt_generated
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
out/
!**/src/main/**/out/
!**/src/test/**/out/

# ─── Sistema ───
.DS_Store
Thumbs.db
*.pem

# ─── Stitch (design references) ───
stich/

# ─── Outros ───
*.log
*.swp
*.swo
*~
